# Copy this file to ".env" and fill in your values.

# --- AI provider (Groq) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional: pin a specific Groq model (e.g. llama-3.3-70b-versatile).
# If not set, the app auto-selects a current general-purpose chat model on startup.
# GROQ_MODEL=

# --- Database ---
# Default (leave as-is) uses a local SQLite file — zero setup, great for development.
DATABASE_URL=sqlite:///./knowledge_tasks.db

# To use Supabase (hosted Postgres) instead, comment the line above and use the
# "Connection string" from Supabase -> Project Settings -> Database. Example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
